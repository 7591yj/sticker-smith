{
  "name": "sticker-smith",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --dir apps/desktop dev",
    "build": "pnpm build:shared && pnpm --dir apps/desktop build",
    "build:shared": "pnpm --dir packages/shared build",
    "format": "prettier --write . --ignore-path .gitignore && cd tg-webm-converter && poetry run black .",
    "test": "pnpm test:shared && pnpm --dir apps/desktop test",
    "test:shared": "pnpm --dir packages/shared test",
    "test:python": "cd tg-webm-converter && poetry run pytest",
    "lint": "pnpm lint:shared && pnpm --dir apps/desktop lint && cd tg-webm-converter && poetry run pytest tests/test_gui_api.py -q",
    "lint:shared": "pnpm --dir packages/shared lint",
    "package:linux": "pnpm --dir apps/desktop package:linux",
    "package:backend": "bash ./tg-webm-converter/scripts/package_backend.sh"
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "keytar",
      "tdl"
    ]
  }
}
